<#
.SYNOPSIS
    This PowerShell script ensures that all local volumes use the NTFS file system
    to comply with DISA STIG WN11-00-000050.

.NOTES
    Author          : Brandon Cobb
    GitHub          : https://github.com/brandocobb-Ghub/
    Date Created    : 06-26-2026
    Last Modified   : 06-26-2026
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-00-000050
    Documentation   : https://stigaview.com/products/win11/v2r7/WN11-00-000050/

.USAGE
    Run this script as Administrator.

    Example:

    PS C:\> .\WN11-00-000050.ps1

.DESCRIPTION
    DISA STIG WN11-00-000050 requires all local volumes
    with drive letters to use the NTFS file system.

    FAT/FAT32 volumes can be converted to NTFS without
    formatting.

    exFAT, ReFS, and other file systems require manual
    backup and formatting.
#> Write-Host "===================================================" -ForegroundColor Cyan
Write-Host "STIG Remediation: WN11-00-000050"
Write-Host "Verify Local Volumes are NTFS"
Write-Host "===================================================" -ForegroundColor Cyan
Write-Host ""

$Volumes = Get-Volume |
Where-Object {
    $_.DriveLetter -ne $null
}

$NonCompliant = @()

foreach ($Volume in $Volumes)
{
    Write-Host "Drive $($Volume.DriveLetter):  FileSystem = $($Volume.FileSystem)"

    if ($Volume.FileSystem -ne "NTFS")
    {
        $NonCompliant += $Volume

        if ($Volume.FileSystem -eq "FAT32")
        {
            Write-Host ""
            Write-Host "[INFO] Converting drive $($Volume.DriveLetter): to NTFS..." -ForegroundColor Yellow

            convert "$($Volume.DriveLetter):" /FS:NTFS /NoSecurity
        }
        else
        {
            Write-Warning "$($Volume.DriveLetter): uses $($Volume.FileSystem). Manual backup and format required."
        }
    }
}

Write-Host ""
Write-Host "Verification Results"
Write-Host "---------------------------------------------------"

Get-Volume |
Where-Object {$_.DriveLetter} |
Select DriveLetter, FileSystem |
Format-Table -AutoSize

if ((Get-Volume | Where-Object {$_.DriveLetter -and $_.FileSystem -ne "NTFS"}).Count -eq 0)
{
    Write-Host ""
    Write-Host "STATUS: COMPLIANT" -ForegroundColor Green
    exit 0
}
else
{
    Write-Host ""
    Write-Host "STATUS: NON-COMPLIANT" -ForegroundColor Red
    exit 1
